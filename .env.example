# ============================================================
#  kamihub 环境变量模板
#  复制成 .env 后修改：cp .env.example .env
#  .env 不要提交到 git
# ============================================================

# ---------- 对外地址（必填，影响提货链接） ----------
# 买家实际能访问到的地址。提货链接会拼成 ${APP_BASE_URL}/d/{token}
# 本地调试：http://localhost:8080
# 生产：https://api.your-domain.com
APP_BASE_URL=http://localhost:8080

LOG_LEVEL=info

# ---------- 数据库 ----------
DB_USER=kamihub
# 生成：openssl rand -hex 16
DB_PASSWORD=请改成强密码
DB_NAME=kamihub

# ---------- 密钥（必填，两个都要自己生成） ----------
# openssl rand -hex 32
# 用于签发登录令牌
JWT_SECRET=请改成64位随机hex
# openssl rand -hex 32   （或 backend 下 `go run ./cmd/keytool -mode genkey`）
# 用于加密平台凭证（app_secret 等）与用户两步验证密钥。
#
# ⚠️ 换这个 key 不是「改个值」那么简单 —— 必须走轮换流程，
#    否则所有上游凭证和用户 TOTP 密钥会一起解不开（静默、不回滚不了）。
#    完整步骤见 docs/roadmap/17-密钥轮换预案.md。
#    最重要的是：**首次部署当天就把这一行备份到离线位置**。
ENCRYPTION_KEY=请改成另一个64位随机hex
# 历史密钥，只在轮换窗口期填写，多个用英文逗号分隔。
# 平时留空/删掉。跑完 `keytool -mode rotate` 并确认清零后即可移除。
# ENCRYPTION_KEY_OLD=

# 登录令牌有效期
JWT_TTL=12h

# ---------- 初始管理员 ----------
# 留空密码则首次启动自动生成并打印在日志里（推荐）
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=

# ---------- 提货链接 ----------
# 默认有效期，168h = 7 天。后台可为单个链接延长或作废
DELIVERY_DEFAULT_TTL=168h
# token 随机字节数，不要低于 16
DELIVERY_TOKEN_BYTES=32

# ---------- 上游调用 ----------
# 上游返回「待发货」时最多轮询多久
UPSTREAM_POLL_TIMEOUT=30s
UPSTREAM_POLL_INTERVAL=2s

# 创建/更新货源时，是否向上游校验商品是否存在，并用询价结果预填库存与成本缓存。
# true  = 配错上游商品编号会在「配置时」立刻报错（推荐）
# false = 不校验，配错了要等买家下单才暴露
# 单次请求也可以传 "skip_verify": true 临时跳过。
UPSTREAM_VERIFY_SUPPLY=true
